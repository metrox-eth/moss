#124786 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#124787 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#124788 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-03),#124785,
  'distance_accuracy_value','confusion accuracy');
#124789 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
ENDSEC;
END-ISO-10303-21;
