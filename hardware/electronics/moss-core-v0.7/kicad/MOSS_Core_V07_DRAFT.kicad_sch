(kicad_sch (version 20250114) (generator "eeschema") (uuid f243e979-af0d-59fe-ba61-8f0ca6ff181c) (paper "A2") (title_block (title "MOSS Core V0.7 DRAFT / system overview") (date "2026-10-29") (rev "V0.7 DRAFT") (company "MOSS / Laurent & Codex"))(lib_symbols (symbol "MOSS:PWR_FLAG" (power) (pin_numbers hide) (pin_names (offset 0) hide) (in_bom no) (on_board yes) (property "Reference" "#FLG" (at 0 1.905 0) (effects (font (size 1.27 1.27)) hide)) (property "Value" "PWR_FLAG" (at 0 3.81 0) (effects (font (size 1.27 1.27)))) (symbol "PWR_FLAG_0_1" (polyline (pts (xy 0 0) (xy 0 1.27) (xy -1.27 1.905) (xy 0 2.54) (xy 1.27 1.905) (xy 0 1.27)) (stroke (width 0) (type default)) (fill (type none)))) (symbol "PWR_FLAG_1_1" (pin power_out line (at 0 0 90) (length 0) (name "pwr" (effects (font (size 1.27 1.27)))) (number "1" (effects (font (size 1.27 1.27))))))))(text "MOSS CORE V0.7 DRAFT" (at 20.32 15.24 0) (effects (font (size 4 4)) (justify left top)) (uuid 4d31696e-115f-5f7a-89d1-4eb8159fc1c2))(text "80 x 75 mm / stacked Orange Pi / dual motor-current sensing" (at 20.32 25.4 0) (effects (font (size 2 2)) (justify left top)) (uuid c1159e4e-f17a-5d4d-90b3-6b8089584a24))(text "PROTOTYPE - ERC/DRC do not validate analogue, firmware or real rover behavior." (at 20.32 35.56 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid 20a9c57c-a934-535b-a744-9661bd859dc5))(sheet (at 20.32 50.8) (size 260.35 30.48) (fields_autoplaced yes) (stroke (width .254) (type default)) (fill (color 0 0 0 0)) (uuid cb99ba43-8952-5bb3-ae00-eb2656403989)(property "Sheetname" "01 USB Power" (at 20.32 49.53 0) (effects (font (size 1.27 1.27)) (justify left)))(property "Sheetfile" "01_USB_Power.kicad_sch" (at 20.32 83.82 0) (effects (font (size 1.27 1.27)) (justify left)))(instances (project "MOSS_Core_V07_DRAFT" (path "/f243e979-af0d-59fe-ba61-8f0ca6ff181c" (page "2")))))(text "Core USB device powered by host hub; separate from OrangePi5V source. RF disabled; encoder supply only after\nenumeration. Verify USB budget." (at 24.13 55.88 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid 25b2ecf2-75d7-5f58-8305-b1dc00784c9a))(sheet (at 299.72 50.8) (size 260.35 30.48) (fields_autoplaced yes) (stroke (width .254) (type default)) (fill (color 0 0 0 0)) (uuid 94ec12f2-d80b-521f-8c2e-90dde364e5eb)(property "Sheetname" "02 Controller" (at 299.72 49.53 0) (effects (font (size 1.27 1.27)) (justify left)))(property "Sheetfile" "02_Controller.kicad_sch" (at 299.72 83.82 0) (effects (font (size 1.27 1.27)) (justify left)))(instances (project "MOSS_Core_V07_DRAFT" (path "/f243e979-af0d-59fe-ba61-8f0ca6ff181c" (page "3")))))(text "ESP32-S3-WROOM-1U-N8. New firmware pin map; native USB serial/audio functions require implementation. External I2C\nADC for left/right winding currents." (at 303.53 55.88 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid 24f7a74e-e340-5d0a-9623-0346fb0b3261))(sheet (at 20.32 99.06) (size 260.35 30.48) (fields_autoplaced yes) (stroke (width .254) (type default)) (fill (color 0 0 0 0)) (uuid bf8bd66f-692d-5a5c-8e53-1f1d17cd1da3)(property "Sheetname" "03 Hardware Interlock" (at 20.32 97.79 0) (effects (font (size 1.27 1.27)) (justify left)))(property "Sheetfile" "03_Hardware_Interlock.kicad_sch" (at 20.32 132.08 0) (effects (font (size 1.27 1.27)) (justify left)))(instances (project "MOSS_Core_V07_DRAFT" (path "/f243e979-af0d-59fe-ba61-8f0ca6ff181c" (page "4")))))(text "Watchdog resets MCU on timeout. Downstream ACT_READY inhibits drive and servo data when actuator rail is off. E-stop\nauxiliary contact also requests stretched reset; fresh manual arming required." (at 24.13 104.14 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid 8df0c5b8-569d-5ea0-8a9a-a8e4ef0ffae6))(sheet (at 299.72 99.06) (size 260.35 30.48) (fields_autoplaced yes) (stroke (width .254) (type default)) (fill (color 0 0 0 0)) (uuid 51494b1c-0d88-5cf9-9cc1-71426b099cc8)(property "Sheetname" "04 Drive Encoders" (at 299.72 97.79 0) (effects (font (size 1.27 1.27)) (justify left)))(property "Sheetfile" "04_Drive_Encoders.kicad_sch" (at 299.72 132.08 0) (effects (font (size 1.27 1.27)) (justify left)))(instances (project "MOSS_Core_V07_DRAFT" (path "/f243e979-af0d-59fe-ba61-8f0ca6ff181c" (page "5")))))(text "External CytronMDD10A PWM/DIR control and two encoder interfaces. No motor power inside the logic connector." (at 303.53 104.14 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid 264fa4f9-fda0-596c-9bfb-43730790cc8a))(sheet (at 20.32 147.32) (size 260.35 30.48) (fields_autoplaced yes) (stroke (width .254) (type default)) (fill (color 0 0 0 0)) (uuid a397f9ec-30a6-5a7a-9972-ab684a5c5a06)(property "Sheetname" "05 Servo" (at 20.32 146.05 0) (effects (font (size 1.27 1.27)) (justify left)))(property "Sheetfile" "05_Servo.kicad_sch" (at 20.32 180.34 0) (effects (font (size 1.27 1.27)) (justify left)))(instances (project "MOSS_Core_V07_DRAFT" (path "/f243e979-af0d-59fe-ba61-8f0ca6ff181c" (page "6")))))(text "Six addressed servos on one powered DATA/V+/GND connector. No external serial adapter and no shared2.5A current\nlimiter. Verify harness rating." (at 24.13 152.4 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid d06e06be-e377-5b38-8903-727624e092ad))(sheet (at 299.72 147.32) (size 260.35 30.48) (fields_autoplaced yes) (stroke (width .254) (type default)) (fill (color 0 0 0 0)) (uuid c7f111bf-1ccc-5842-acc3-1d06c7645201)(property "Sheetname" "06 Audio" (at 299.72 146.05 0) (effects (font (size 1.27 1.27)) (justify left)))(property "Sheetfile" "06_Audio.kicad_sch" (at 299.72 180.34 0) (effects (font (size 1.27 1.27)) (justify left)))(instances (project "MOSS_Core_V07_DRAFT" (path "/f243e979-af0d-59fe-ba61-8f0ca6ff181c" (page "7")))))(text "MAX98357A integrated for4-ohm/3W speaker. Both output terminals active. Start muted; firmware volume/load tests\nrequired." (at 303.53 152.4 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid 47445fbd-1637-5ee2-aa29-529e02419855))(sheet (at 20.32 195.58) (size 260.35 30.48) (fields_autoplaced yes) (stroke (width .254) (type default)) (fill (color 0 0 0 0)) (uuid fdf679f3-6594-53fb-9e4b-2c79be3a749c)(property "Sheetname" "07 Battery Voltage" (at 20.32 194.31 0) (effects (font (size 1.27 1.27)) (justify left)))(property "Sheetfile" "07_Battery_Voltage.kicad_sch" (at 20.32 228.6 0) (effects (font (size 1.27 1.27)) (justify left)))(instances (project "MOSS_Core_V07_DRAFT" (path "/f243e979-af0d-59fe-ba61-8f0ca6ff181c" (page "8")))))(text "INA226bus-voltage only,0x40. Shuntinputs shortedGND. Motor currents use independent PWM-compatible measurement\nchannels." (at 24.13 200.66 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid aadc115b-b2a3-5806-badd-6502112c9d88))(sheet (at 299.72 195.58) (size 260.35 30.48) (fields_autoplaced yes) (stroke (width .254) (type default)) (fill (color 0 0 0 0)) (uuid c91a2f50-1d07-5440-ab37-964bec32971c)(property "Sheetname" "09 Audio Power" (at 299.72 194.31 0) (effects (font (size 1.27 1.27)) (justify left)))(property "Sheetfile" "09_Audio_Power.kicad_sch" (at 299.72 228.6 0) (effects (font (size 1.27 1.27)) (justify left)))(instances (project "MOSS_Core_V07_DRAFT" (path "/f243e979-af0d-59fe-ba61-8f0ca6ff181c" (page "9")))))(text "Existing separate5.077V audio buck retained to avoid spending hostUSB current budget on speaker peaks. F2 protects\nits input branch." (at 303.53 200.66 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid 590df96b-d12b-5365-96c4-fc4cae1244df))(sheet (at 20.32 243.84) (size 260.35 30.48) (fields_autoplaced yes) (stroke (width .254) (type default)) (fill (color 0 0 0 0)) (uuid 5b8e4b07-ec1a-5b56-89b4-eb2b18fe8a65)(property "Sheetname" "10 Battery Power" (at 20.32 242.57 0) (effects (font (size 1.27 1.27)) (justify left)))(property "Sheetfile" "10_Battery_Power.kicad_sch" (at 20.32 276.86 0) (effects (font (size 1.27 1.27)) (justify left)))(instances (project "MOSS_Core_V07_DRAFT" (path "/f243e979-af0d-59fe-ba61-8f0ca6ff181c" (page "10")))))(text "Externally fused3S input and inputTVS. Q50 feeds Cytron/servo; host and audio remain unswitched.\nConductor/connector/regeneration qualification remains required." (at 24.13 248.92 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid a6755db6-0b96-5ba8-9276-618089b608fe))(sheet (at 299.72 243.84) (size 260.35 30.48) (fields_autoplaced yes) (stroke (width .254) (type default)) (fill (color 0 0 0 0)) (uuid 28dd437e-34c6-5785-b3f5-1df4850f1439)(property "Sheetname" "16 Orange Pi Power" (at 299.72 242.57 0) (effects (font (size 1.27 1.27)) (justify left)))(property "Sheetfile" "16_Orange_Pi_Power.kicad_sch" (at 299.72 276.86 0) (effects (font (size 1.27 1.27)) (justify left)))(instances (project "MOSS_Core_V07_DRAFT" (path "/f243e979-af0d-59fe-ba61-8f0ca6ff181c" (page "11")))))(text "Soldered Waveshare5Vmodule andcompact3.15ASMDinputfuse. USB-CsourceCC/attach/switch control. Never bridge host\noutput to USBdeviceVBUS." (at 303.53 248.92 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid d7b7f73e-082d-547f-9cce-add144268c2d))(sheet (at 20.32 292.1) (size 260.35 30.48) (fields_autoplaced yes) (stroke (width .254) (type default)) (fill (color 0 0 0 0)) (uuid 03b51654-a433-5786-a696-ab37007e36ff)(property "Sheetname" "17 Motor Current" (at 20.32 290.83 0) (effects (font (size 1.27 1.27)) (justify left)))(property "Sheetfile" "17_Motor_Current.kicad_sch" (at 20.32 325.12 0) (effects (font (size 1.27 1.27)) (justify left)))(instances (project "MOSS_Core_V07_DRAFT" (path "/f243e979-af0d-59fe-ba61-8f0ca6ff181c" (page "12")))))(text "Separate left/right in-linebidirectional motor currents; two shunts andPWM-rejecting amplifiers.\nValidateADCcalibration,transients and thermal performance." (at 24.13 297.18 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid edc24cdc-9b5e-5bcd-a21b-2a8d4ad88933))(sheet (at 299.72 292.1) (size 260.35 30.48) (fields_autoplaced yes) (stroke (width .254) (type default)) (fill (color 0 0 0 0)) (uuid 28e22d8a-694e-56c0-bc47-be66de848a3d)(property "Sheetname" "18 Actuator Cutoff" (at 299.72 290.83 0) (effects (font (size 1.27 1.27)) (justify left)))(property "Sheetfile" "18_Actuator_Cutoff.kicad_sch" (at 299.72 325.12 0) (effects (font (size 1.27 1.27)) (justify left)))(instances (project "MOSS_Core_V07_DRAFT" (path "/f243e979-af0d-59fe-ba61-8f0ca6ff181c" (page "13")))))(text "One physical NC opens Q50 gate sink regardless of MCU command. Second NC requests MCU reset; release requires fresh\nmanual arming. Unknown actual button terminal orientation must be verified. Single MOSFET is not redundant or\nsafety-certified; inrush, stored energy and regeneration require bench tests." (at 303.53 297.18 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid 5e4c48d3-d8a4-5297-a6d0-e5979fb3a4bc))(sheet (at 20.32 340.36) (size 260.35 30.48) (fields_autoplaced yes) (stroke (width .254) (type default)) (fill (color 0 0 0 0)) (uuid 46b7b368-5525-57da-949e-65f26c2f9cc9)(property "Sheetname" "19 Fans" (at 20.32 339.09 0) (effects (font (size 1.27 1.27)) (justify left)))(property "Sheetfile" "19_Fans.kicad_sch" (at 20.32 373.38 0) (effects (font (size 1.27 1.27)) (justify left)))(instances (project "MOSS_Core_V07_DRAFT" (path "/f243e979-af0d-59fe-ba61-8f0ca6ff181c" (page "14")))))(text "Two12V nominal3010 fans,common1A fuse upstream of Q50;0.2A combined assumed,not measured. Verify XH\nmate/polarity,voltage/startup and wire limits." (at 24.13 345.44 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid 564f1f24-04ff-5791-b002-843c1770a59a))(symbol (lib_id "MOSS:PWR_FLAG") (at 50.8 388.62 0) (unit 1) (in_bom no) (on_board yes) (dnp no) (uuid e4e73ef3-f059-5807-ac75-7e29532e82c6)(property "Reference" "#FLG1" (at 50.8 383.62 0) (effects (font (size 1.27 1.27)) (hide yes)))(property "Value" "PWR_FLAG" (at 50.8 385.62 0) (effects (font (size 1.27 1.27))))(pin "1" (uuid 0230f362-ae14-5d09-812c-c67ff15f791c)) (instances (project "MOSS_Core_V07_DRAFT" (path "/f243e979-af0d-59fe-ba61